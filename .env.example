# AWS Bootstrap Configuration Environment Variables
# Copy this file to .env and fill in your values

# Required AWS credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here

# AWS region where resources will be created
AWS_REGION=us-east-1

# GitHub organization (auto-detected from git remote, but you can override)
# GITHUB_ORG=your-github-username-or-org

# Optional: Custom role name (defaults to github-actions-terraform)
# GITHUB_ROLE_NAME=github-actions-terraform